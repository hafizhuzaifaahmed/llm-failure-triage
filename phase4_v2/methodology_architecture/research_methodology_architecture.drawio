h="330" height="590" as="geometry"/></mxCell><mxCell id="env" value="&lt;b&gt;Execution environment (controlled)&lt;/b&gt;&lt;br&gt;WSL2 Ubuntu 22.04.5 · OpenJDK 11.0.32&lt;br&gt;Defects4J v3.0.1 · recorded environment manifest&lt;br&gt;TZ America/Los_Angeles · locale en_US" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#000000;rounded=0;shadow=0;glass=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;dashed=1;dashPattern=1 2;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="352" y="92" width="306" height="88" as="geometry"/></mxCell><mxCell id="checkout" value="&lt;b&gt;Checkout&lt;/b&gt; buggy (B) and fixed (F) version of every focal method" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#000000;rounded=0;shadow=0;glass=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="352" y="198" width="306" height="50" as="geometry"/></mxCell><mxCell id="gen" value="&lt;b&gt;Test generation&lt;/b&gt; · generator G&lt;br&gt;Gemma 4 26B-A4B (local, Q4_K_M)&lt;br&gt;3 generations per focal method from the buggy context, T = 0.7" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#000000;rounded=0;shadow=0;glass=0;fillColor=#D9D9D9;strokeColor=#000000;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="352" y="266" width="306" height="76" as="geometry"/></mxCell><mxCell id="compile" value="&lt;b&gt;Compile&lt;/b&gt; each test class against B and F; prune non-compiling methods (≤ 3 passes)" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#000000;rounded=0;shadow=0;glass=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="352" y="360" width="306" height="50" as="geometry"/></mxCell><mxCell id="exec" value="&lt;b&gt;Dual execution&lt;/b&gt;&lt;br&gt;each test method 3× on B and 3× on F; fresh JVM per run; 30 s timeout" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#000000;rounded=0;shadow=0;glass=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="352" y="428" width="306" height="62" as="geometry"/></mxCell><mxCell id="frec" value="&lt;b&gt;Failure record&lt;/b&gt;: outcome, exception, message, failing test line, stack trace (every run)" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#000000;rounded=0;shadow=0;glass=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="352" y="508" width="306" height="56" as="geometry"/></mxCell><mxCell id="eC0a" value="" style="rounded=0;html=1;fontFamily=Arial;fontSize=10;fontColor=#000000;strokeColor=#000000;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;strokeWidth=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev" target="checkout"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="334"/><mxPoint x="330" y="223"/></Array></mxGeometry></mxCell><mxCell id="eC0b" value="" style="rounded=0;html=1;fontFamily=Arial;fontSize=10;fontColor=#000000;strokeColor=#000000;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;strokeWidth=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="test" target="checkout"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="131" y="436"/><mxPoint x="330" y="436"/><mxPoint x="330" y="223"/></Array></mxGeometry></mxCell><mxCell id="eC0c" value="" style="rounded=0;html=1;fontFamily=Arial;fontSize=10;fontColor=#000000;strokeColor=#000000;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="checkout"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="508"/><mxPoint x="330" y="223"/></Array></mxGeometry></mxCell><mxCell id="eC1" value="" style="rounded=0;html=1;fontFamily=Arial;fontSize=10;fontColor=#000000;strokeColor=#000000;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;strokeWidth=1;" edge="1" parent="1" source="checkout" target="gen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eC2" value="" style="rounded=0;html=1;fontFamily=Arial;fontSize=10;fontColor=#000000;strokeColor=#000000;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;strokeWidth=1;" edge="1" parent="1" source="gen" target="compile"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eC3" value="" style="rounded=0;html=1;fontFamily=Arial;fontSize=10;fontColor=#000000;strokeColor=#000000;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;strokeWidth=1;" edge="1" parent="1" source="compile" target="exec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eC4" value="" style="rounded=0;html=1;fontFamily=Arial;fontSize=10;fontColor=#000000;strokeColor=#000000;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;strokeWidth=1;" edge="1" parent="1" source="exec" target="frec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="secD" value="D  Preprocessing and evidence construction" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#000000;rounded=0;shadow=0;glass=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="55" width="320" height="590" as="geometry"/></mxCell><mxCell id="p1" value="1  Parse generated test classes; drop unparsable classes" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#000000;rounded=0;shadow=0;glass=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="702" y="92" width="296" height="48" as="geometry"/></mxCell><mxCell id="p2" value="2  De-duplicate test bodies (normalised-body hash within each focal method)" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#000000;rounded=0;shadow=0;glass=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="702" y="156" width="296" height="48" as="geometry"/></mxCell><mxCell id="p3" value="3  Exclude FLAKY, TIMEOUT, ENV and NC outcomes (ENV re-run once)" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#000000;rounded=0;shadow=0;glass=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="702" y="220" width="296" height="48" as="geometry"/></mxCell><mxCell id="p4" value="4  Stack traces: keep project and test frames (≤ 25), collapse framework frames; scrub paths, object hashes, timestamps" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#000000;rounded=0;shadow=0;glass=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="702" y="284" width="296" height="62" as="geometry"/></mxCell><mxCell id="p5" value="5  Length limits: message ≤ 500 chars; Javadoc ≤ 600, specification ≤ 400, package ≤ 6,000 tokens" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#000000;rounded=0;shadow=0;glass=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="702" y="362" width="296" height="62" as="geometry"/></mxCell><mxCell id="p6" value="6  Leakage guard: block any call whose package contains bug ids, fixed-only lines, focal-body lines or paths" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#000000;rounded=0;shadow=0;glass=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="702" y="440" width="296" height="62" as="geometry"/></mxCell><mxCell id="p7" value="&lt;b&gt;7  Context builder&lt;/b&gt; (deterministic, no LLM): evidence package whose items carry citable ids" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#000000;rounded=0;shadow=0;glass=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="702" y="518" width="296" height="62" as="geometry"/></mxCell><mxCell id="ep1p2" value="" style="rounded=0;html=1;fontFamily=Arial;fontSize=10;fontColor=#000000;strokeColor=#000000;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;strokeWidth=1;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ep2p3" value="" style="rounded=0;html=1;fontFamily=Arial;fontSize=10;fontColor=#000000;strokeColor=#000000;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;strokeWidth=1;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ep3p4" value="" style="rounded=0;html=1;fontFamily=Arial;fontSize=10;fontColor=#000000;strokeColor=#000000;endArrow=block;endFill=1;endSize