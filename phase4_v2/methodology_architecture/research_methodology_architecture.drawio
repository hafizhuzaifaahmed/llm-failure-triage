<mxfile host="diagrams.net" type="device"><diagram id="methodology" name="Methodology architecture"><mxGraphModel dx="2300" dy="1700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1700" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Research methodology architecture: LLM triage of failing generated unit tests (program fault vs test fault)" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#000000;rounded=0;shadow=0;glass=0;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1700" height="30" as="geometry"/></mxCell><mxCell id="secA" value="A  Datasets and project-level partitioning" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#000000;rounded=0;shadow=0;glass=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="55" width="300" height="590" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;D1 · Defects4J 3.0.1&lt;/b&gt; (real faults)&lt;br&gt;17 projects; frame 312 methods / 220 defects&lt;br&gt;cap 25 per project → 234 methods / 167 defects" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#000000;rounded=0;shadow=0;glass=0;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="32" y="92" width="276" height="112" as="geometry"/></mxCell><mxCell id="split" value="&lt;b&gt;Project-level split&lt;/b&gt;&lt;br&gt;seeded draw, made before any test generation" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#000000;rounded=0;shadow=0;glass=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="32" y="226" width="276" height="46" as="geometry"/></mxCell><mxCell id="dev" value="&lt;b&gt;Development&lt;/b&gt;&lt;br&gt;3 projects&lt;br&gt;(Cli, Gson, Jsoup)&lt;br&gt;39 methods&lt;br&gt;prompt rounds, pilot, gates, k&lt;sub&gt;T&lt;/sub&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#000000;rounded=0;shadow=0;glass=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="176" y="296" width="132" height="128" as="geometry"/></mxCell><mxCell id="test" value="&lt;b&gt;Held-out test&lt;/b&gt;&lt;br&gt;14 projects&lt;br&gt;195 methods&lt;br&gt;every reported D1 result" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#000000;rounded=0;shadow=0;glass=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="32" y="296" width="132" height="128" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;D2 · Seeded faults&lt;/b&gt; (contamination control)&lt;br&gt;F = fixed version; B = F + one killed Major&lt;br&gt;mutant inside a held-out focal method&lt;br&gt;(≤ 2 per method) · 284 mutants" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#000000;rounded=0;shadow=0;glass=0;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="32" y="448" width="276" height="120" as="geometry"/></mxCell><mxCell id="noteA" value="Development projects serve prompt development, the pilot and the development gates only; they never enter held-out evaluation." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#000000;rounded=0;shadow=0;glass=0;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;" vertex="1" pare