   "source_class": "package org.apache.commons.lang;\n\nimport java.io.*;\nimport java.math.*;\nimport java.util.*;\nimport org.junit.*;\nimport org.junit.Test;\nimport static org.junit.Assert.*;\n\npublic class WordUtils_abbreviate_TriageGen0Test {\n\n    \n\n    \n\n    \n\n    \n\n    @Test\n    public void testAbbreviate_UpperLessThanLower() {\n        // lower = 5, upper = 2. upper becomes 5.\n        // index of space in \"hello world\" starting at 5 is 5.\n        // index (5) is not > upper (5), and index is not -1.\n        // enters else block: substring(0, 5) + \"...\" -> \"hello...\"\n        assertEquals(\"hello...\", WordUtils.abbreviate(\"hello world\", 5, 2, \"...\"));\n    }\n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n}\n"
